--- a/usr.sbin/cellman/Makefile
+++ b/usr.sbin/cellman/Makefile
@@ -4,6 +4,8 @@ PROG=	cellman
 SRCS=	main.c
 MAN=	cellman.8 cellman-spec.5
 
+.include <bsd.own.mk>
+
 .PATH: ${.CURDIR}/api ${.CURDIR}/commands
 
 WARNS?=	4
@@ -26,4 +28,86 @@ ${PROG}: libcellman.a
 DPADD+=	libcellman.a ${LIBLUA} ${LIBM}
 LDADD+=	libcellman.a -llua -lm
 
+.if ${MKSHARE} != "no"
